{
  "name": "FinSight",
  "private": true,
  "version": "1.0.0",
  "description": "<div align=\"center\">",
  "main": "index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:workspaces": "npm run test --workspace=web && npm run test --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "type-check:web": "npm run lint --workspace=web",
    "type-check:api": "npm run build --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "lint:api": "npm run lint --workspace=api",
    "lint": "npm run lint:web && npm run lint:api",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:gen:types": "supabase gen types --lang typescript --project-ref esnfalxdcufywylvmiyn > apps/web/src/lib/database.types.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
